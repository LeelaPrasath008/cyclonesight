# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model identifier (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TERRAIN_PROVIDER: "mock" (offline default) or "gee" (Google Earth Engine)
TERRAIN_PROVIDER="mock"

# Google Earth Engine service account credentials (when TERRAIN_PROVIDER="gee")
GEE_SERVICE_ACCOUNT="your-service-account@project.iam.gserviceaccount.com"
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Early-Warning Dispatch channels (all DRY_RUN by default)
DRY_RUN="true"

# Optional Email Dispatch (Resend or SMTP)
RESEND_API_KEY=""

# Optional Telegram Bot Dispatch
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional Twilio SMS Dispatch
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

